# competitor-watch keys. This file is gitignored; never commit it or paste it into a chat log.
#
# Apify reads LinkedIn posts (company pages and people). Free plan: $5 of usage a month.
#   Key: https://console.apify.com/settings/integrations
APIFY_TOKEN=
#
# Tavily adds news search and reads pages that block plain requests. Free plan: 1,000 credits a month.
#   Key: https://app.tavily.com
TAVILY_API_KEY=
#
# Optional: where `cw deliver` posts the digest (Slack or Discord incoming webhook, or any JSON endpoint).
CW_WEBHOOK_URL=
#
# Optional: the headless agent that triages scheduled runs, e.g. claude -p / codex exec / gemini -p
CW_TRIAGE_CMD=
